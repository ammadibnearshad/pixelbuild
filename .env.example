# Contact form → Google Sheets
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Service account email, e.g. pixelbuild-forms@my-project.iam.gserviceaccount.com
GOOGLE_SHEETS_CLIENT_EMAIL=

# The `private_key` value from the service account JSON, in double quotes, with
# its \n sequences left escaped exactly as they appear in the JSON file.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional. Defaults to Enquiries!A:F — change if your tab has another name.
GOOGLE_SHEETS_RANGE=Enquiries!A:F
